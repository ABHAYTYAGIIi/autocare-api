PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
MAINTENANCE_SERVICE_URL=http://localhost:8001
MAINTENANCE_SERVICE_TIMEOUT_MS=5000

# Explicit persistence selection: memory (local development) or postgres.
DATABASE_PROVIDER=memory

# Required only when DATABASE_PROVIDER=postgres. These are placeholders only.
DATABASE_HOST=your-server.postgres.database.azure.com
DATABASE_PORT=5432
DATABASE_NAME=autocare
DATABASE_USER=postgres
DATABASE_PASSWORD=replace-me
DATABASE_SSL=true
